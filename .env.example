# Copy to .env. Never commit actual credentials.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=replace-with-local-password
# Set after choosing your provider; these are server-only.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Gemini/Groq agent adapters: choose actual available model IDs.
AGENT_PROVIDER=gemini
AGENT_FALLBACK_PROVIDER=groq
GEMINI_MODEL=
GEMINI_API_KEY=
GROQ_MODEL=
GROQ_API_KEY=
